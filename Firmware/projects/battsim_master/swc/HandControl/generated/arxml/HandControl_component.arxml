                                        </INTEGER-VALUE-VARIATION-POINT>
                                    </VALUE-ACCESS>
                                </VARIATION-POINT-PROXY>
                            </VARIATION-POINT-PROXYS>
                        </SWC-INTERNAL-BEHAVIOR>
                    </INTERNAL-BEHAVIORS>
                </APPLICATION-SW-COMPONENT-TYPE>
            </ELEMENTS>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>
